// 상품 목록 조회
###
GET http://localhost:4000/products?page=&sort=&search=

// 상품 생성
###
POST http://localhost:4000/products
Content-Type: application/json

{
    "name": "a의 상품",
    "description": "사람 입니다.",
    "price": 500,
    "tags": ["인간"]
}

