###
// 상품 등록 
// POST http://localhost:3000/products
POST {{baseUrl}}/products
Content-Type: application/json
Cookie: access-token={{accessToken}}

{
  "name": "축구공",
  "description": "축구공",
  "price": 17000,
  "tags": ["SPORTS"]
}

###
# // 상품 조회
GET {{baseUrl}}/products/7
Cookie: access-token={{accessToken}}



### 상품 수정 
# // PATCH http://localhost:3000/products/{productId}
PATCH {{baseUrl}}/products/7
Content-Type: application/json
Cookie: access-token={{accessToken}}

{
  "description": "화장품",
  "price" : 6600
}

### 상품 삭제 
// DELETE http://localhost:3000/products/{productId}
DELETE {{baseUrl}}/products/6
Cookie: access-token={{accessToken}}


### 상품 댓글 등록 
POST {{baseUrl}}/products/7/comments
Content-Type: application/json
Cookie: access-token={{accessToken}}

{
  "content": "nike 옷이 정말 좋아보이는군요."
}


### 유저의 상품 조회 
GET {{baseUrl}}/products/myProduct
Cookie: access-token={{accessToken}}

### 유저가 상품 좋아요
POST {{baseUrl}}/products/1/like
Cookie: access-token={{accessToken}}

