// 회원가입
###
POST http://localhost:4000/users/registration
Content-Type: application/json

{
    "email": "b@a.com",
    "nickname": "nickname",
    "password": "password"
}

// 로그인
###
POST http://localhost:4000/users/login
Content-Type: application/json

{
    "email": "b@a.com",
    "password": "password"
}

// 엑세스, 리프레쉬 토큰 갱신
###
POST http://localhost:4000/users/token/refresh

// 로그아웃
###
POST http://localhost:4000/users/logout

// 유저 정보 조회
###
GET http://localhost:4000/users/user/profile

// 유저 정보 수정
###
PATCH http://localhost:4000/users/user/update
Content-Type: application/json

{
    "nickname": "newNickname",
    "password": "password",
    "newPassword": "password"
}

// 유저가 등록한 상품 목록
###
GET http://localhost:4000/users/user/products

// 상품 좋아요, 해제 버튼
###
POST http://localhost:4000/users/products/94dba363-a076-4a9e-9fe0-dfb35ee12e91

// 게시글 좋아요, 해제 버튼
###
POST http://localhost:4000/users/articles/97feeee8-b482-47b5-bf96-272751fdaa66

// 상품 좋아요 리스트
###
GET http://localhost:4000/users/products/like

// 게시글 좋아요 리스트
###
GET http://localhost:4000/users/articles/like