// 상품 목록 조회
###
GET http://localhost:4000/products?page=&sort=&search=

// 상품 생성
###
POST http://localhost:4000/products
Content-Type: application/json

{
    "name": "a의 상품",
    "description": "사람 입니다.",
    "price": 500,
    "tags": ["인간"]
}

// 상품 상세 조회
###
GET http://localhost:4000/products/87d4bcd8-08f8-4c94-91af-e51f8a41b2ea

// 상품 수정
###
PATCH http://localhost:4000/products/87d4bcd8-08f8-4c94-91af-e51f8a41b2ea
Content-Type: application/json

{
    "name": "삼성 수퍼 울트라 갤럭시 S23",
    "description": "새것 같은 중고다 이말이야",
    "price": 500000,
    "tags": ["전자기기","폰","중고"]
}

// 상품 삭제
###
DELETE http://localhost:4000/products/87d4bcd8-08f8-4c94-91af-e51f8a41b2ea

